    url:"#contact"
  }

];

/* DISPLAY RECORDS */
function displayRecords(data){

  const list=document.getElementById("recordList");

  if(!data.length){
    list.innerHTML=
      '<div class="record"><h3>No records found</h3><p>Try another search term or record category.</p></div>';
    return;
  }

  list.innerHTML=data.map(function(record){

    const link =
      record.url && record.url !== "#contact"
      ? `<a href="${record.url}" target="_blank" rel="noopener noreferrer" class="btn btn-green" style="margin-top:12px;padding:9px 14px;font-size:.8rem;">View Source</a>`
      : "";

    return `
      <article class="record">
        <div class="record-type">${record.type}</div>
        <h3>${record.title}</h3>
        <div class="record-meta">
          ${record.date} • ${record.source}
        </div>
        <p>${record.summary}</p>
        ${link}
      </article>
    `;

  }).join("");

}

/* FILTER */
function filterRecords(){

  const search=
    document.getElementById("recordSearch").value.toLowerCase();

  const type=
    document.getElementById("recordType").value;

  const filtered=records.filter(function(record){

    const matchesSearch =
      record.title.toLowerCase().includes(search) ||
      record.summary.toLowerCase().includes(search) ||
      record.source.toLowerCase().includes(search);

    const matchesType =
      type==="all" || record.type===type;

    return matchesSearch && matchesType;
  });

  displayRecords(filtered);
}

displayRecords(records);

</script>

