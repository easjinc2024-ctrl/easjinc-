<style>
:root{
    --navy:#0A2342;
    --green:#005A3C;
    --gold:#C5962B;
    --blue:#087EBD;
    --light-blue:#EAF6FC;
    --light:#F5F8FA;
    --white:#FFFFFF;
    --dark:#17202A;
    --gray:#667085;
    --border:#D9E2EA;
    --shadow:0 8px 25px rgba(10,35,66,.10);
}

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    scroll-behavior:smooth;
}

body{
    font-family:Arial, Helvetica, sans-serif;
    line-height:1.65;
    color:var(--dark);
    background:var(--light);
}

a{
    color:inherit;
    text-decoration:none;
}

.container{
    width:92%;
    max-width:1200px;
    margin:auto;
}

/* TOP BAR */
.topbar{
    background:var(--navy);
    color:white;
    font-size:14px;
    padding:8px 0;
}

.topbar .container{
    display:flex;
    justify-content:space-between;
    gap:15px;
    flex-wrap:wrap;
}

.topbar a{
    color:#fff;
}

.topbar a:hover{
    color:#FFD66B;
}

/* HEADER */
header{
    background:white;
    position:sticky;
    top:0;
    z-index:1000;
    box-shadow:0 3px 15px rgba(0,0,0,.08);
}

.header-inner{
    min-height:82px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:20px;
}

.brand{
    display:flex;
    align-items:center;
    gap:12px;
}

.logo{
    width:62px;
    height:62px;
    border:3px solid var(--gold);
    border-radius:50%;
    display:flex;
    align-items:center;
    justify-content:center;
    background:linear-gradient(145deg,var(--navy),var(--green));
    color:white;
    position:relative;
    box-shadow:0 3px 10px rgba(0,0,0,.15);
}

.logo:before{
    content:"⚖";
    font-size:29px;
    color:#fff;
}

.logo:after{
    content:"EASJ";
    position:absolute;
    bottom:3px;
    font-size:8px;
    font-weight:bold;
    letter-spacing:1px;
    color:#FFD66B;
}

.brand-text h1{
    font-size:20px;
    color:var(--green);
    line-height:1.1;
}

.brand-text p{
    font-size:11px;
    color:var(--navy);
    font-weight:bold;
    letter-spacing:.4px;
}

nav ul{
    display:flex;
    list-style:none;
    gap:5px;
    align-items:center;
}

nav a{
    display:block;
    padding:10px 11px;
    color:var(--navy);
    font-weight:bold;
    font-size:14px;
    border-radius:5px;
}

nav a:hover{
    background:var(--blue);
    color:white;
}

.menu-btn{
    display:none;
    background:var(--navy);
    color:white;
    border:none;
    padding:10px 14px;
    border-radius:5px;
    font-size:20px;
}

/* HERO */
.hero{
    background:
    linear-gradient(120deg,rgba(10,35,66,.96),rgba(0,90,60,.91),rgba(8,126,189,.88));
    color:white;
    padding:90px 0;
}

.hero-content{
    max-width:850px;
}

.hero .eyebrow{
    color:#FFD66B;
    font-weight:bold;
    letter-spacing:2px;
    text-transform:uppercase;
    font-size:14px;
    margin-bottom:15px;
}

.hero h2{
    font-size:clamp(34px,6vw,62px);
    line-height:1.08;
    margin-bottom:22px;
}

.hero h2 span{
    color:#FFD66B;
}

.hero p{
    font-size:19px;
    max-width:780px;
    color:#F4F9FC;
}

.hero-buttons{
    display:flex;
    gap:14px;
    margin-top:30px;
    flex-wrap:wrap;
}

.btn{
    display:inline-block;
    padding:13px 22px;
    border-radius:5px;
    font-weight:bold;
    transition:.2s;
}

.btn-gold{
    background:var(--gold);
    color:white;
}

.btn-blue{
    background:var(--blue);
    color:white;
}

.btn-outline{
    border:2px solid white;
    color:white;
}

.btn:hover{
    transform:translateY(-2px);
    opacity:.92;
}

/* SECTIONS */
section{
    padding:75px 0;
}

.section-title{
    text-align:center;
    margin-bottom:45px;
}

.section-title .line{
    width:60px;
    height:4px;
    background:var(--gold);
    margin:12px auto;
}

.section-title h2{
    color:var(--navy);
    font-size:34px;
}

.section-title p{
    max-width:750px;
    margin:auto;
    color:var(--gray);
}

/* ABOUT */
.about-grid{
    display:grid;
    grid-template-columns:1.2fr .8fr;
    gap:40px;
    align-items:center;
}

.about-card{
    background:white;
    padding:30px;
    border-radius:10px;
    box-shadow:var(--shadow);
    border-top:5px solid var(--green);
}

.about-card h3{
    color:var(--green);
    margin-bottom:15px;
}

.highlight{
    border-left:5px solid var(--blue);
    background:var(--light-blue);
    padding:20px;
    margin-top:20px;
}

/* FOUNDER */
.founder{
    background:white;
}

.founder-grid{
    display:grid;
    grid-template-columns:.75fr 1.25fr;
    gap:45px;
    align-items:center;
}

.founder-box{
    background:linear-gradient(145deg,var(--navy),var(--green));
    color:white;
    padding:40px 25px;
    border-radius:12px;
    text-align:center;
    box-shadow:var(--shadow);
}

.founder-circle{
    width:150px;
    height:150px;
    border:5px solid var(--gold);
    border-radius:50%;
    margin:0 auto 20px;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:55px;
}

.founder-box h3{
    color:#FFD66B;
    font-size:22px;
}

.founder-box p{
    font-size:14px;
}

.founder-text h3{
    color:var(--navy);
    font-size:30px;
    margin-bottom:15px;
}

.signature{
    margin-top:25px;
    padding:18px;
    border-left:4px solid var(--gold);
    background:#FAF8F0;
    color:var(--navy);
    font-weight:bold;
}

/* PILLARS */
.pillars{
    background:#F0F5F8;
}

.cards{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:22px;
}

.card{
    background:white;
    padding:28px;
    border-radius:9px;
    box-shadow:var(--shadow);
    border-top:4px solid var(--blue);
    transition:.2s;
}

.card:hover{
    transform:translateY(-4px);
}

.card .icon{
    font-size:34px;
    margin-bottom:12px;
}

.card h3{
    color:var(--navy);
    margin-bottom:10px;
}

/* PROGRAMS */
.program{
    border-left-color:var(--green);
}

.program h3{
    color:var(--green);
}

/* ADVOCACY */
.advocacy{
    background:var(--navy);
    color:white;
}

.advocacy .section-title h2{
    color:white;
}

.advocacy .section-title p{
    color:#DDEAF2;
}

.advocacy-list{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:15px;
}

.advocacy-item{
    background:rgba(255,255,255,.08);
    padding:18px 20px;
    border-left:4px solid var(--gold);
    border-radius:5px;
}

.advocacy-item strong{
    color:#FFD66B;
}

/* PUBLIC RECORD */
.record{
    background:white;
}

.record-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:20px;
}

.record-card{
    padding:25px;
    background:var(--light);
    border-radius:8px;
    border:1px solid var(--border);
}

.record-card h3{
    color:var(--blue);
    margin-bottom:10px;
}

/* MISSION */
.mission-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:20px;
}

.mission-box{
    text-align:center;
    padding:30px 20px;
    background:white;
    box-shadow:var(--shadow);
    border-radius:9px;
}

.mission-box h3{
    color:var(--green);
    margin-bottom:10px;
}

/* CONTACT */
.contact{
    background:#EDF5F8;
}

.contact-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:35px;
}

.contact-box{
    background:white;
    padding:30px;
    border-radius:10px;
    box-shadow:var(--shadow);
}

.contact-box h3{
    color:var(--navy);
    margin-bottom:18px;
}

.contact-item{
    margin:15px 0;
    padding-bottom:12px;
    border-bottom:1px solid var(--border);
}

.contact-item strong{
    color:var(--green);
}

/* CTA */
.cta{
    background:linear-gradient(100deg,var(--green),var(--blue));
    color:white;
    text-align:center;
}

.cta h2{
    font-size:35px;
    margin-bottom:15px;
}

.cta p{
    max-width:750px;
    margin:auto;
    font-size:17px;
}

/* FOOTER */
footer{
    background:var(--navy);
    color:white;
    padding:45px 0 20px;
}

.footer-grid{
    display:grid;
    grid-template-columns:1.3fr 1fr 1fr;
    gap:35px;
}

footer h3{
    color:#FFD66B;
    margin-bottom:15px;
}

footer p,
footer li{
    color:#D8E4EC;
    font-size:14px;
}

footer ul{
    list-style:none;
}

footer li{
    margin:8px 0;
}

footer a:hover{
    color:#FFD66B;
}

.copyright{
    border-top:1px solid rgba(255,255,255,.15);
    margin-top:30px;
    padding-top:20px;
    text-align:center;
    color:#B7C7D3;
    font-size:13px;
}

/* RESPONSIVE */
@media(max-width:950px){

    nav{
        display:none;
        position:absolute;
        left:0;
        right:0;
        top:82px;
        background:white;
        box-shadow:0 10px 20px rgba(0,0,0,.12);
    }

    nav.active{
        display:block;
    }

    nav ul{
        flex-direction:column;
        align-items:stretch;
        padding:10px;
    }

    nav a{
        padding:13px;
    }

    .menu-btn{
        display:block;
    }

    .about-grid,
    .founder-grid,
    .contact-grid{
        grid-template-columns:1fr;
    }

    .cards,
    .record-grid,
    .mission-grid{
        grid-template-columns:repeat(2,1fr);
    }
}

@media(max-width:650px){

    .topbar .container{
        justify-content:center;
        text-align:center;
    }

    .brand-text h1{
        font-size:16px;
    }

    .brand-text p{
        font-size:9px;
    }

    .logo{
        width:52px;
        height:52px;
    }

    .hero{
        padding:65px 0;
    }

    .hero p{
        font-size:16px;
    }

    section{
        padding:55px 0;
    }

    .cards,
    .record-grid,
    .mission-grid,
    .advocacy-list,
    .footer-grid{
        grid-template-columns:1fr;
    }

    .section-title h2{
        font-size:28px;
    }

    .hero-buttons{
        flex-direction:column;
    }

    .btn{
        text-align:center;
    }
}
</style>
</head>

