<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>EASJ INC | Alliance for Justice, Fairness and Freedom</title>

<meta name="description" content="Education Accountability and Social Justice (EASJ INC) — Alliance for Justice, Fairness and Freedom. Promoting accountability, advancing justice, empowering communities, and strengthening institutions.">
<meta name="keywords" content="EASJ INC, Education Accountability, Social Justice, Liberia, Justice, Fairness, Freedom, Governance, Education, Human Rights, Accountability">
<meta name="author" content="Education Accountability and Social Justice (EASJ INC)">

<meta property="og:title" content="EASJ INC | Alliance for Justice, Fairness and Freedom">
<meta property="og:description" content="Promoting Accountability, Advancing Justice, Empowering Communities, and Strengthening Institutions.">
<meta property="og:type" content="website">

<style>
:root{
  --navy:#0A2342;
  --navy-dark:#06172C;
  --navy-light:#163B67;

  --green:#005A3C;
  --green-dark:#003D2A;
  --green-light:#0A7652;

  --gold:#C5962B;
  --gold-light:#E0B958;
  --gold-pale:#F6EBCB;

  --white:#FFFFFF;
  --cream:#F8F7F2;
  --light:#F2F5F4;
  --text:#17231E;
  --muted:#66716D;
  --border:#D9E1DE;

  --shadow:0 12px 35px rgba(10,35,66,.10);
  --radius:16px;
}

*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

html{
  scroll-behavior:smooth;
}

body{
  font-family:Arial,Helvetica,sans-serif;
  line-height:1.65;
  color:var(--text);
  background:var(--white);
}

a{
  color:inherit;
  text-decoration:none;
}

img{
  max-width:100%;
  display:block;
}

.container{
  width:min(1180px,92%);
  margin:auto;
}

/* TOP STRIP */
.top-strip{
  background:var(--green);
  color:white;
  padding:8px 0;
  font-size:.88rem;
}

.top-strip-inner{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:20px;
}

.top-strip strong{
  color:var(--gold-light);
}

/* HEADER */
header{
  position:sticky;
  top:0;
  z-index:1000;
  background:var(--navy);
  box-shadow:0 4px 18px rgba(0,0,0,.18);
  border-bottom:4px solid var(--gold);
}

.navbar{
  min-height:82px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:25px;
}

.brand{
  display:flex;
  align-items:center;
  gap:14px;
}

.brand-mark{
  width:62px;
  height:62px;
  border:3px solid var(--gold);
  border-radius:50%;
  display:flex;
  align-items:center;
  justify-content:center;
  background:var(--white);
  color:var(--navy);
  font-weight:900;
  font-size:1rem;
  text-align:center;
  line-height:1;
  box-shadow:0 0 0 4px rgba(197,150,43,.18);
}

.brand-text h1{
  color:white;
  font-size:1.12rem;
  letter-spacing:.4px;
}

.brand-text p{
  color:var(--gold-light);
  font-size:.72rem;
  font-weight:700;
  text-transform:uppercase;
  letter-spacing:1px;
}

nav ul{
  display:flex;
  list-style:none;
  align-items:center;
  gap:5px;
}

nav a{
  display:block;
  color:white;
  padding:10px 11px;
  border-radius:7px;
  font-size:.88rem;
  font-weight:700;
  transition:.25s;
}

nav a:hover{
  background:var(--green);
  color:var(--gold-light);
}

.menu-btn{
  display:none;
  border:2px solid var(--gold);
  background:transparent;
  color:white;
  padding:8px 12px;
  border-radius:8px;
  font-size:1.3rem;
}

/* HERO */
.hero{
  position:relative;
  overflow:hidden;
  background:
    linear-gradient(135deg,rgba(10,35,66,.98),rgba(0,90,60,.94));
  color:white;
  padding:95px 0 85px;
}

.hero:before{
  content:"";
  position:absolute;
  width:500px;
  height:500px;
  border-radius:50%;
  border:1px solid rgba(197,150,43,.20);
  right:-180px;
  top:-180px;
}

.hero:after{
  content:"";
  position:absolute;
  width:300px;
  height:300px;
  border-radius:50%;
  border:1px solid rgba(255,255,255,.10);
  left:-130px;
  bottom:-160px;
}

.hero-grid{
  position:relative;
  z-index:2;
  display:grid;
  grid-template-columns:1.35fr .65fr;
  gap:55px;
  align-items:center;
}

.eyebrow{
  display:inline-block;
  color:var(--gold-light);
  border-left:4px solid var(--gold);
  padding-left:12px;
  font-weight:800;
  text-transform:uppercase;
  letter-spacing:1.5px;
  margin-bottom:18px;
  font-size:.85rem;
}

.hero h2{
  font-size:clamp(2.4rem,5vw,4.5rem);
  line-height:1.06;
  margin-bottom:22px;
}

.hero h2 span{
  color:var(--gold-light);
}

.hero p{
  color:#e8efec;
  max-width:760px;
  font-size:1.08rem;
}

.hero-buttons{
  display:flex;
  flex-wrap:wrap;
  gap:12px;
  margin-top:30px;
}

.btn{
  display:inline-block;
  padding:13px 20px;
  border-radius:8px;
  font-weight:800;
  border:2px solid transparent;
  transition:.25s;
  cursor:pointer;
}

.btn-gold{
  background:var(--gold);
  color:var(--navy);
}

.btn-gold:hover{
  background:var(--gold-light);
  transform:translateY(-2px);
}

.btn-green{
  background:var(--green);
  color:white;
}

.btn-green:hover{
  background:var(--green-light);
}

.btn-outline{
  border-color:var(--gold);
  color:white;
}

.btn-outline:hover{
  background:var(--gold);
  color:var(--navy);
}

.hero-card{
  background:white;
  color:var(--text);
  border-radius:20px;
  padding:28px;
  box-shadow:0 20px 45px rgba(0,0,0,.22);
  border-top:6px solid var(--gold);
}

.hero-card .seal{
  width:120px;
  height:120px;
  margin:0 auto 20px;
  border-radius:50%;
  background:var(--navy);
  border:7px solid var(--gold);
  outline:5px solid var(--green);
  color:white;
  display:flex;
  align-items:center;
  justify-content:center;
  text-align:center;
  font-weight:900;
  font-size:1.1rem;
}

.hero-card h3{
  text-align:center;
  color:var(--navy);
}

.hero-card p{
  color:var(--muted);
  text-align:center;
  font-size:.94rem;
  margin-top:8px;
}

/* SECTION */
section{
  padding:82px 0;
}

.section-head{
  max-width:780px;
  margin-bottom:42px;
}

.section-head.center{
  text-align:center;
  margin-left:auto;
  margin-right:auto;
}

.kicker{
  color:var(--green);
  font-weight:900;
  text-transform:uppercase;
  letter-spacing:1.4px;
  font-size:.8rem;
  margin-bottom:8px;
}

.section-head h2{
  color:var(--navy);
  font-size:clamp(1.9rem,4vw,3rem);
  line-height:1.15;
  margin-bottom:14px;
}

.section-head h2 span{
  color:var(--green);
}

.section-head p{
  color:var(--muted);
}

/* ABOUT */
.about{
  background:var(--cream);
}

.about-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:40px;
}

.about-box{
  background:white;
  padding:32px;
  border-radius:var(--radius);
  box-shadow:var(--shadow);
  border-left:5px solid var(--green);
}

.about-box h3{
  color:var(--navy);
  margin-bottom:12px;
}

.about-box:nth-child(2){
  border-left-color:var(--gold);
}

.about-box p{
  color:var(--muted);
}

.identity-bar{
  margin-top:35px;
  padding:25px;
  background:var(--navy);
  color:white;
  border-radius:var(--radius);
  border-bottom:5px solid var(--gold);
  text-align:center;
}

.identity-bar strong{
  color:var(--gold-light);
}

/* VALUES */
.values-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:20px;
}

.value-card{
  padding:28px;
  border-radius:var(--radius);
  background:white;
  box-shadow:var(--shadow);
  border-top:5px solid var(--navy);
}

.value-card:nth-child(2){
  border-top-color:var(--green);
}

.value-card:nth-child(3){
  border-top-color:var(--gold);
}

.value-card h3{
  color:var(--navy);
  margin-bottom:10px;
}

.value-card p{
  color:var(--muted);
  font-size:.95rem;
}

/* FOUNDER */
.founder{
  background:var(--navy);
  color:white;
}

.founder-grid{
  display:grid;
  grid-template-columns:.7fr 1.3fr;
  gap:50px;
  align-items:center;
}

.founder-portrait{
  min-height:340px;
  border-radius:20px;
  background:
    linear-gradient(145deg,var(--green),var(--navy-light));
  border:4px solid var(--gold);
  display:flex;
  align-items:center;
  justify-content:center;
  text-align:center;
  padding:25px;
}

.founder-initials{
  width:180px;
  height:180px;
  border-radius:50%;
  border:8px solid var(--gold);
  outline:5px solid rgba(255,255,255,.25);
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:3.5rem;
  font-weight:900;
  color:white;
}

.founder h2{
  font-size:2.6rem;
  margin-bottom:7px;
}

.founder .role{
  color:var(--gold-light);
  font-weight:800;
  margin-bottom:22px;
}

.founder p{
  color:#dce7e3;
  margin-bottom:15px;
}

.signature{
  margin-top:25px;
  border-left:4px solid var(--gold);
  padding-left:16px;
}

.signature strong{
  display:block;
  color:white;
}

/* PILLARS */
.pillars{
  background:var(--light);
}

.pillar-grid{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:18px;
}

.pillar{
  display:flex;
  gap:18px;
  background:white;
  padding:24px;
  border-radius:13px;
  border-left:5px solid var(--green);
  box-shadow:0 7px 22px rgba(10,35,66,.06);
}

.pillar:nth-child(3n){
  border-left-color:var(--gold);
}

.pillar-number{
  min-width:44px;
  height:44px;
  border-radius:50%;
  background:var(--navy);
  color:var(--gold-light);
  display:flex;
  align-items:center;
  justify-content:center;
  font-weight:900;
}

.pillar h3{
  color:var(--navy);
  margin-bottom:5px;
  font-size:1.05rem;
}

.pillar p{
  color:var(--muted);
  font-size:.9rem;
}

/* PROGRAMS */
.program-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:22px;
}

.program{
  background:white;
  border-radius:var(--radius);
  box-shadow:var(--shadow);
  padding:28px;
  border-top:5px solid var(--green);
  transition:.25s;
}

.program:hover{
  transform:translateY(-5px);
}

.program:nth-child(2),
.program:nth-child(5){
  border-top-color:var(--gold);
}

.program:nth-child(3),
.program:nth-child(6){
  border-top-color:var(--navy);
}

.program-icon{
  width:48px;
  height:48px;
  border-radius:10px;
  background:var(--navy);
  color:var(--gold-light);
  display:flex;
  align-items:center;
  justify-content:center;
  font-weight:900;
  margin-bottom:18px;
}

.program h3{
  color:var(--navy);
  margin-bottom:9px;
}

.program p{
  color:var(--muted);
  font-size:.93rem;
}

/* RECORD CENTER */
.records{
  background:var(--cream);
}

.record-tools{
  display:grid;
  grid-template-columns:1.4fr .6fr;
  gap:12px;
  margin-bottom:25px;
}

.record-tools input,
.record-tools select{
  width:100%;
  padding:14px;
  border:1px solid var(--border);
  border-radius:9px;
  font-size:1rem;
  outline:none;
}

.record-tools input:focus,
.record-tools select:focus{
  border-color:var(--green);
}

.record-list{
  display:grid;
  gap:15px;
}

.record{
  background:white;
  border-radius:12px;
  padding:24px;
  border-left:5px solid var(--navy);
  box-shadow:0 5px 18px rgba(10,35,66,.06);
}

.record:nth-child(even){
  border-left-color:var(--gold);
}

.record-type{
  color:var(--green);
  font-size:.76rem;
  font-weight:900;
  text-transform:uppercase;
  letter-spacing:1px;
}

.record h3{
  color:var(--navy);
  margin:5px 0;
}

.record-meta{
  color:var(--muted);
  font-size:.82rem;
  margin-bottom:8px;
}

.record p{
  color:var(--muted);
  font-size:.92rem;
}

/* POLICY */
.policy{
  background:var(--navy);
  color:white;
}

.policy-grid{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:18px;
}

.policy-card{
  padding:25px;
  border:1px solid rgba(255,255,255,.15);
  border-radius:13px;
  background:rgba(255,255,255,.05);
}

.policy-card h3{
  color:var(--gold-light);
  margin-bottom:8px;
}

.policy-card p{
  color:#dce5e1;
  font-size:.92rem;
}

/* GET INVOLVED */
.involved{
  background:var(--green);
  color:white;
}

.involved-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:30px;
  align-items:center;
}

.involved h2{
  font-size:2.6rem;
  margin-bottom:15px;
}

.involved p{
  color:#e2eee9;
}

.involved-box{
  background:white;
  color:var(--text);
  padding:30px;
  border-radius:var(--radius);
  border-top:6px solid var(--gold);
}

.involved-box h3{
  color:var(--navy);
  margin-bottom:10px;
}

/* CONTACT */
.contact{
  background:var(--light);
}

.contact-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:35px;
}

.contact-card{
  background:white;
  padding:30px;
  border-radius:var(--radius);
  box-shadow:var(--shadow);
}

.contact-card h3{
  color:var(--navy);
  margin-bottom:15px;
}

.contact-item{
  padding:13px 0;
  border-bottom:1px solid var(--border);
}

.contact-item:last-child{
  border-bottom:none;
}

.contact-item strong{
  color:var(--green);
  display:block;
  font-size:.82rem;
  text-transform:uppercase;
  letter-spacing:.7px;
}

.contact-item a{
  color:var(--navy);
  font-weight:700;
}

.contact-item a:hover{
  color:var(--green);
}

/* FOOTER */
footer{
  background:var(--navy-dark);
  color:white;
  border-top:6px solid var(--gold);
}

.footer-main{
  padding:55px 0 35px;
  display:grid;
  grid-template-columns:1.2fr .8fr .8fr;
  gap:35px;
}

.footer-brand h2{
  font-size:1.3rem;
  margin-bottom:8px;
}

.footer-brand .gold{
  color:var(--gold-light);
}

.footer-brand p{
  color:#c8d5d1;
  font-size:.9rem;
}

footer h3{
  color:var(--gold-light);
  margin-bottom:13px;
  font-size:1rem;
}

footer ul{
  list-style:none;
}

footer li{
  margin-bottom:7px;
}

footer li a{
  color:#cbd8d4;
  font-size:.9rem;
}

footer li a:hover{
  color:var(--gold-light);
}

.footer-bottom{
  border-top:1px solid rgba(255,255,255,.13);
  padding:20px 0;
  display:flex;
  justify-content:space-between;
  gap:20px;
  flex-wrap:wrap;
  color:#aebdb8;
  font-size:.8rem;
}

/* MOBILE */
@media(max-width:950px){

  .menu-btn{
    display:block;
  }

  nav{
    display:none;
    position:absolute;
    left:0;
    right:0;
    top:82px;
    background:var(--navy-dark);
    border-top:1px solid rgba(255,255,255,.1);
  }

  nav.open{
    display:block;
  }

  nav ul{
    flex-direction:column;
    align-items:stretch;
    padding:15px;
  }

  nav a{
    padding:13px;
  }

  .hero-grid,
  .founder-grid,
  .about-grid,
  .involved-grid,
  .contact-grid{
    grid-template-columns:1fr;
  }

  .program-grid,
  .values-grid{
    grid-template-columns:repeat(2,1fr);
  }

  .footer-main{
    grid-template-columns:1fr 1fr;
  }
}

@media(max-width:650px){

  .top-strip-inner{
    flex-direction:column;
    gap:2px;
    text-align:center;
  }

  .brand-text h1{
    font-size:.94rem;
  }

  .brand-text p{
    font-size:.62rem;
  }

  .brand-mark{
    width:52px;
    height:52px;
  }

  .hero{
    padding:65px 0;
  }

  section{
    padding:60px 0;
  }

  .hero h2{
    font-size:2.45rem;
  }

  .pillar-grid,
  .program-grid,
  .values-grid,
  .policy-grid,
  .footer-main{
    grid-template-columns:1fr;
  }

  .record-tools{
    grid-template-columns:1fr;
  }

  .founder h2,
  .involved h2{
    font-size:2rem;
  }
}
</style>
</head>

<body>

<!-- TOP INFORMATION BAR -->
<div class="top-strip">
  <div class="container top-strip-inner">
    <div><strong>EASJ INC</strong> — Alliance for Justice, Fairness and Freedom</div>
    <div>Justice • Fairness • Freedom</div>
  </div>
</div>

<!-- HEADER -->
<header>
  <div class="container navbar">

    <a href="#home" class="brand">
      <div class="brand-mark">EASJ<br>INC</div>
      <div class="brand-text">
        <h1>Education Accountability &amp; Social Justice</h1>
        <p>Alliance for Justice, Fairness and Freedom</p>
      </div>
    </a>

    <button class="menu-btn" onclick="toggleMenu()" aria-label="Open navigation">
      ☰
    </button>

    <nav id="mainNav">
      <ul>
        <li><a href="#home">Home</a></li>
        <li><a href="#about">About</a></li>
        <li><a href="#founder">Founder</a></li>
        <li><a href="#pillars">Advocacy</a></li>
        <li><a href="#programs">Programs</a></li>
        <li><a href="#records">Public Record</a></li>
        <li><a href="#policies">Principles</a></li>
        <li><a href="#contact">Contact</a></li>
      </ul>
    </nav>

  </div>
</header>

<!-- HERO -->
<section class="hero" id="home">
  <div class="container hero-grid">

    <div>
      <div class="eyebrow">Education Accountability &amp; Social Justice</div>

      <h2>
        Advancing <span>Justice.</span><br>
        Strengthening <span>Accountability.</span>
      </h2>

      <p>
        Education Accountability and Social Justice (EASJ INC) is an
        independent public-interest organization committed to promoting
        accountability, advancing justice, empowering communities, and
        strengthening institutions.
      </p>

      <div class="hero-buttons">
        <a href="#about" class="btn btn-gold">Discover EASJ INC</a>
        <a href="#records" class="btn btn-outline">Public Record Center</a>
      </div>
    </div>

    <div class="hero-card">
      <div class="seal">EASJ<br>INC</div>
      <h3>Alliance for Justice, Fairness and Freedom</h3>
      <p>
        Founded January 8, 2024
      </p>
      <p>
        Justice • Fairness • Freedom
      </p>
    </div>

  </div>
</section>

<!-- ABOUT -->
<section class="about" id="about">
  <div class="container">

    <div class="section-head center">
      <div class="kicker">Who We Are</div>
      <h2>Education Accountability &amp; <span>Social Justice</span></h2>
      <p>
        EASJ INC works in the public interest to encourage accountable
        governance, equitable opportunities, respect for human rights,
        quality education, institutional integrity and community empowerment.
      </p>
    </div>

    <div class="about-grid">

      <div class="about-box">
        <h3>Our Mission</h3>
        <p>
          To promote accountability, justice, fairness and freedom through
          evidence-informed advocacy, civic engagement, education,
          research, public-interest analysis and constructive institutional
          dialogue.
        </p>
      </div>

      <div class="about-box">
        <h3>Our Vision</h3>
        <p>
          A Liberia and a wider society where institutions are accountable,
          citizens are empowered, human rights are respected, justice is
          accessible, and every person has a fair opportunity to participate
          and thrive.
        </p>
      </div>

      <div class="about-box">
        <h3>Our Mandate</h3>
        <p>
          EASJ INC focuses on public-interest issues involving education,
          governance, justice, human rights, democracy, workers' rights,
          social inclusion, community development, environmental protection
          and institutional accountability.
        </p>
      </div>

      <div class="about-box">
        <h3>Our Approach</h3>
        <p>
          We seek to combine research, public education, documentation,
          policy analysis, peaceful advocacy, civic participation and
          responsible engagement with public and private institutions.
